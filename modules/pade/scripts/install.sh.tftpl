#!/usr/bin/env bash
set -euo pipefail

PADE_VERSION='${PADE_VERSION}'
BINDINGS_B64='${BINDINGS_B64}'
INSTALL_DIR="$HOME/.local/bin"
BINDINGS_PATH="$HOME/.config/pade/coder-bindings.yaml"

case "$(uname -s)" in
  Linux) os="linux" ;;
  *) echo "pade-coder: Linux workspaces are required" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  x86_64|amd64) arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  *) echo "pade-coder: unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

asset="pade-${PADE_VERSION}-${os}-${arch}.tar.gz"
base_url="https://github.com/After-Certainty/pade/releases/download/${PADE_VERSION}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

curl -fsSL --retry 2 -o "$tmp/$asset" "$base_url/$asset"
curl -fsSL --retry 2 -o "$tmp/SHA256SUMS" "$base_url/SHA256SUMS"
awk -v asset="$asset" '$2 == asset { print }' "$tmp/SHA256SUMS" > "$tmp/SHA256SUMS.asset"
test -s "$tmp/SHA256SUMS.asset"
(cd "$tmp" && sha256sum -c SHA256SUMS.asset)

mkdir -p "$tmp/extract" "$INSTALL_DIR" "$(dirname "$BINDINGS_PATH")"
tar -xzf "$tmp/$asset" -C "$tmp/extract"
pade_binary="$(find "$tmp/extract" -type f -name pade -print -quit)"
test -n "$pade_binary"
cp "$pade_binary" "$INSTALL_DIR/pade"
chmod 0755 "$INSTALL_DIR/pade"

printf "%s" "$BINDINGS_B64" | base64 -d > "$BINDINGS_PATH"
chmod 0600 "$BINDINGS_PATH"

profile="$HOME/.profile"
touch "$profile"
grep -qF 'export PATH="$HOME/.local/bin:$PATH"' "$profile" || printf '\n# pade-coder\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$profile"
grep -qF 'export PADE_BINDINGS="$HOME/.config/pade/coder-bindings.yaml"' "$profile" || printf 'export PADE_BINDINGS="$HOME/.config/pade/coder-bindings.yaml"\n' >> "$profile"

export PATH="$INSTALL_DIR:$PATH"
export PADE_BINDINGS="$BINDINGS_PATH"
"$INSTALL_DIR/pade" version
echo "pade-coder: broker bindings written to $BINDINGS_PATH"
echo "pade-coder: Coder owns workspace lifecycle; workload identity comes from the workspace runtime"
