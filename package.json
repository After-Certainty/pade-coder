{
  "name": "pade-coder",
  "private": true,
  "scripts": {
    "test": "bun test",
    "fmt": "bun x prettier --write . && terraform fmt -recursive",
    "fmt:ci": "bun x prettier --check . && terraform fmt -check -recursive"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "bun-types": "^1.3.4",
    "prettier": "^3.7.4",
    "prettier-plugin-sh": "^0.18.0",
    "prettier-plugin-terraform-formatter": "^1.2.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-sh",
      "prettier-plugin-terraform-formatter"
    ]
  }
}
